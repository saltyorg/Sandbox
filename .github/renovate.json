{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable"
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "ansible": {
        "enabled": false
    },
    "baseBranchPatterns": [
        "$default"
    ], 
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "description": "Major pip requirements updates",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "requirements/*"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "pip",
                "major"
            ]
        },
        {
            "description": "pip requirements",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "requirements/*"
            ],
            "groupName": "requirements",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "pip"
            ]
        },
        {
            "description": "Major GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "github-actions",
                "major"
            ]
        },
        {
            "description": "GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "description": "Shared workflow result actions",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "saltyorg/github-actions"
            ],
            "pinDigests": false,
            "groupName": "workflow-result-actions",
            "labels": [
                "dependencies",
                "github-actions"
            ]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Saltbox Go linter release",
            "managerFilePatterns": [".github/workflows/sandbox.yml", ".github/workflows/sandbox-os.yml"],
            "matchStrings": [
                "uses: saltyorg/github-actions/saltbox-lint@[^\\s]+\\s+with:\\s+version:\\s+(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "depNameTemplate": "saltyorg/saltbox-lint",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        }
    ],
    "rebaseWhen": "conflicted",
    "vulnerabilityAlerts": {
        "enabled": true,
        "addLabels": [
            "security",
            "vulnerability"
        ]
    },
    "commitMessageAction": "Update",
    "commitMessageTopic": "{{depName}}",
    "commitMessageExtra": "to {{newVersion}}",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "lockFileMaintenance": {
        "enabled": true
    }
}
